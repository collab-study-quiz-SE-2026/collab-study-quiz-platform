# Local development only. Replace the password in your untracked .env.
# Keep values simple: no quotes or spaces (for the PowerShell loader).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=csmqp_dev
PGUSER=csmqp_dev
PGPASSWORD=replace_with_local_dev_password
FRONTEND_ORIGIN=http://localhost:5173,https://localhost
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=REPLACEWITHLOCALACCESSKEY
S3_SECRET_KEY=replace_with_local_storage_secret
S3_BUCKET=csmqp-materials
S3_REGION=us-east-1
