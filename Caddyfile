{
	auto_https disable_redirects
}

https://localhost {
	tls internal {
		protocols tls1.3 tls1.3
	}

	handle_path /api/* {
		reverse_proxy host.docker.internal:8000
	}

	handle /ws/* {
		reverse_proxy host.docker.internal:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
